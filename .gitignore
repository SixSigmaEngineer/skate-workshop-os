# ─── Secrets & config ─────────────────────────────────────────
# Holds API keys (OpenAI, ElevenLabs, …) and personal prefs. NEVER commit.
settings.json
*.env
.env

# ─── Private vault data ───────────────────────────────────────
# Your real workshop/client notes stay local. The committed
# fictional Harborlight demo sessions are whitelisted below so a
# fresh clone works out of the box; anything else you add to the
# vault stays private.
/conversations/*
!/conversations/harborlight-service-access-2026/
!/conversations/harborlight-volunteer-readiness-2026/
/sessions/*
!/sessions/harborlight-service-access-2026/
!/sessions/harborlight-volunteer-readiness-2026/
/transcripts/
/.trash/
# Recorded audio stays private, including recordings made in a demo session.
/conversations/**/attachments/recording-*.wav
/conversations/**/*-meeting-recording-*.md
/INDEX.md

# User-supplied workshop reference material stays local. Keep only the
# repository guide so users know where to place their own licensed sources.
/workshop-knowledge-documents/*
!/workshop-knowledge-documents/README.md
/reference/

# ─── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Virtual environments ─────────────────────────────────────
.venv/
.build-venv/
venv/
env/
ENV/
ui/.venv/

# ─── Build artifacts ──────────────────────────────────────────
build/
dist/
*.spec
SKATE.exe
*.pyz

